# From the Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# From the Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: your test server's ID (right-click server -> Copy Server ID, needs Developer Mode).
# When set, slash commands register instantly to that server only.
DISCORD_GUILD_ID=
# Optional: channel for the daily poppel wisdom at 07:57 (right-click channel -> Copy Channel ID)
DAILY_CHANNEL_ID=
# Optional: the OpenAI-compatible AI server (default http://localhost:8080, llama.cpp as in pod.yaml).
# AI_MODEL only matters for servers that host several models, such as Ollama.
AI_URL=
AI_MODEL=
