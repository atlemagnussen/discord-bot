# From the Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# From the Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional, for testing: a server ID (right-click server -> Copy Server ID, needs Developer Mode).
# When set, slash commands register instantly to that server only. Leave empty to serve every server.
DISCORD_GUILD_ID=
# Optional: channels for the daily poppel wisdom at 07:57, comma-separated, e.g. one per server
# (right-click channel -> Copy Channel ID)
DAILY_CHANNEL_ID=
# Optional: the OpenAI-compatible AI server (default http://localhost:8080, llama.cpp as in pod.yaml).
# AI_MODEL only matters for servers that host several models, such as Ollama.
AI_URL=
AI_MODEL=
